{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-reps.local/schemas/case-reveal.v2.schema.json",
  "title": "PM Reps post-commit reveal v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "companyName", "productName", "source", "whatShipped", "evidenceCommentary", "referenceTradeoffs"],
  "properties": {
    "schemaVersion": { "const": "case-reveal.v2" },
    "caseId": { "type": "string", "minLength": 1 },
    "companyName": { "type": "string", "minLength": 1 },
    "productName": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "canonicalUrl", "publishedAt", "retrievedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    },
    "whatShipped": { "type": "string", "minLength": 1 },
    "evidenceCommentary": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidenceId", "provenance", "text"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "provenance": { "enum": ["shipped_fact", "company_reported", "inference"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "referenceTradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
